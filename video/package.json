{
  "name": "service-b-video",
  "version": "0.1.0",
  "private": true,
  "description": "Templates Remotion usados pelo provider Remotion do módulo video-generation do service-b.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:sample": "remotion render src/index.ts ProductAdStory-9x16 out/sample-9x16.mp4 --props=./sample-props.json",
    "bundle": "remotion bundle src/index.ts --out-dir build",
    "browser:ensure": "remotion browser ensure",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.546",
    "@remotion/fonts": "4.0.546",
    "@remotion/player": "4.0.546",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
