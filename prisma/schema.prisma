generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  brands                Brand[]
  campaigns             Campaign[]
  rules                 CampaignRules[]
  products              Product[]
  media                 MediaAsset[]
  contents              Content[]
  schedules             ContentScheduled[]
  accounts              SocialAccount[]
  credentials           SocialCredential[]
  imageTemplateSettings ImageTemplateSetting[]

  @@map("companies")
}

model User {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  oauthStates  OAuthState[]

  @@unique([companyId, id])
  @@map("users")
}

model OAuthState {
  hash      String   @id
  companyId String
  userId    String
  user      User     @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("oauth_states")
}

enum ContentStatus {
  READY
  APPROVED
  REPROVED
  WAITING
  ERROR
}

// Tipo da foto do produto: só o produto ou com pessoas (em uso, no dia a dia). Os templates de foto escolhem a foto
// de cada cena pelo tipo preferido nela (ImageTemplateSetting).
enum MediaAssetKind {
  PRODUCT
  PERSON
}

// Tipo de mídia do conteúdo: o anúncio é montado com fotos ou com vídeos reais (nunca os dois).
enum ContentMediaType {
  IMAGE
  VIDEO
}

enum PreparationStatus {
  NOT_STARTED
  PENDING
  READY
  FAILED
}

enum VideoStatus {
  PENDING_SCRIPT
  SCRIPT_GENERATING
  PENDING
  SUBMITTING
  RENDERING
  READY
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
}

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
}

enum PublicationStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model Brand {
  id              String     @id @default(uuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  primaryColor    String?
  secondaryColor  String?
  tertiaryColor   String?
  quaternaryColor String?
  voiceTone       String?
  targetAudience  String?
  copyGuidelines  String?
  // Logo da marca no storage (PNG normalizado, com transparência). Os templates mostram no fechamento e no selo da marca.
  logoStorageKey  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  campaigns       Campaign[]
  products        Product[]

  @@unique([companyId, id])
  @@map("brands")
}

model Campaign {
  id        String          @id @default(uuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand           @relation(fields: [companyId, brandId], references: [companyId, id], onDelete: Cascade)
  name      String
  objective String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  rules     CampaignRules[]
  contents  Content[]

  @@unique([companyId, id])
  @@map("campaigns")
}

model CampaignRules {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaingId String
  campaing   Campaign  @relation(fields: [companyId, campaingId], references: [companyId, id], onDelete: Cascade)
  name       String
  guidelines String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  contents   Content[]

  @@unique([companyId, id])
  @@unique([companyId, campaingId, id])
  @@map("campaign_rules")
}

model Product {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand            @relation(fields: [companyId, brandId], references: [companyId, id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal?         @db.Decimal(12, 2)
  oldPrice    Decimal?         @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  media       MediaAsset[]
  contents    Content[]
  appearances ContentProduct[]

  @@unique([companyId, id])
  @@map("products")
}

model MediaAsset {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  storageKey  String         @unique
  contentType String
  bytes       Int
  kind        MediaAssetKind @default(PRODUCT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contents    ContentAsset[]

  @@unique([companyId, id])
  @@index([companyId, productId])
  @@map("media_assets")
}

model Content {
  id                              String                       @id @default(uuid())
  companyId                       String
  campaingId                      String
  campaingRulesId                 String
  productId                       String
  products                        ContentProduct[]
  aiScript                        String
  scriptStatus                    PreparationStatus            @default(NOT_STARTED)
  videoStatus                     PreparationStatus            @default(NOT_STARTED)
  transcriptionStatus             PreparationStatus            @default(NOT_STARTED)
  transcriptionSubmissionId       String?                      @unique
  transcription                   String?
  subtitleSrt                     String?
  subtitleStatus                  PreparationStatus            @default(NOT_STARTED)
  subtitleLeaseUntil              DateTime?
  publicationPreparationRequested Boolean                      @default(false)
  status                          ContentStatus                @default(WAITING)
  // Revisão humana da revisão atual do conteúdo: true aprovado, false reprovado, null aguardando. Só conteúdo aprovado
  // é publicado; uma nova revisão volta para null.
  humanApprove                    Boolean?
  editorial                       Json                         @default("{}")
  // Áudio do anúncio: música de fundo e locução (TTS) do roteiro.
  backgroundMusic                 Boolean                      @default(false)
  voiceover                       Boolean                      @default(false)
  contentMediaType                ContentMediaType             @default(IMAGE)
  embedding                       Unsupported("vector(1536)")?
  revision                        Int                          @default(1)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  assets                          ContentAsset[]
  history                         ContentHistory[]
  renders                         VideoGeneration[]
  videos                          VideoAsset[]
  schedules                       ContentScheduled[]

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaing      Campaign      @relation(fields: [companyId, campaingId], references: [companyId, id], onDelete: Cascade)
  product       Product       @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction)
  campaingRules CampaignRules @relation(fields: [companyId, campaingId, campaingRulesId], references: [companyId, campaingId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, createdAt])
  @@map("contents")
}

model ContentProduct {
  companyId String
  contentId String
  productId String
  content   Content  @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  product   Product  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction)
  createdAt DateTime @default(now())

  @@id([companyId, contentId, productId])
  @@map("content_products")
}

model ContentAsset {
  id           String     @id @default(uuid())
  companyId    String
  contentId    String
  content      Content    @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  mediaAssetId String
  position     Int
  mediaAsset   MediaAsset @relation(fields: [companyId, mediaAssetId], references: [companyId, id], onDelete: NoAction)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([companyId, contentId, mediaAssetId])
  @@map("content_assets")
}

model ContentHistory {
  id        String   @id @default(uuid())
  companyId String
  contentId String
  content   Content  @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  revision  Int
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([companyId, contentId, revision])
  @@map("content_history")
}

model VideoGeneration {
  id                 String      @id @default(uuid())
  companyId          String
  contentId          String
  content            Content     @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  revision           Int
  input              Json
  status             VideoStatus @default(PENDING)
  scriptSubmissionId String?     @unique
  submissionId       String?     @unique
  providerId         String?     @unique
  error              String?
  leaseUntil         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  video              VideoAsset?

  @@unique([companyId, contentId, revision])
  @@unique([companyId, contentId, id])
  @@map("video_generations")
}

model VideoAsset {
  id                  String             @id @default(uuid())
  companyId           String
  contentId           String
  content             Content            @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  generationId        String
  generation          VideoGeneration    @relation(fields: [companyId, contentId, generationId], references: [companyId, contentId, id], onDelete: Cascade)
  revision            Int
  storageKey          String             @unique
  captionedStorageKey String?
  reviewStatus        ContentStatus
  review              Json
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  schedules           ContentScheduled[]

  @@unique([companyId, contentId, generationId])
  @@unique([companyId, contentId, id])
  @@map("video_assets")
}

model SocialAccount {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      SocialPlatform
  externalId    String
  accountHandle String
  displayName   String?
  status        SocialAccountStatus @default(ACTIVE)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  credentials   SocialCredential[]
  publications  Publication[]
  schedules     ContentScheduled[]

  @@unique([companyId, platform, accountHandle])
  @@unique([companyId, platform, externalId])
  @@unique([companyId, id])
  @@map("social_accounts")
}

model SocialCredential {
  id                   String        @id @default(uuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  socialAccountId      String
  socialAccount        SocialAccount @relation(fields: [companyId, socialAccountId], references: [companyId, id], onDelete: Cascade)
  kind                 String
  encryptedValue       String
  initializationVector String
  expiresAt            DateTime?
  scopes               Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([companyId, socialAccountId, kind])
  @@index([socialAccountId, kind])
  @@map("social_credentials")
}

model ContentScheduled {
  id                        String         @id @default(uuid())
  companyId                 String
  company                   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentId                 String?
  content                   Content?       @relation(fields: [companyId, contentId], references: [companyId, id], onDelete: Cascade)
  videoId                   String?
  video                     VideoAsset?    @relation(fields: [companyId, contentId, videoId], references: [companyId, contentId, id], onDelete: NoAction)
  date                      DateTime
  status                    ContentStatus  @default(WAITING)
  socialAccountId           String?
  socialAccount             SocialAccount? @relation(fields: [companyId, socialAccountId], references: [companyId, id], onDelete: NoAction)
  caption                   String?
  preparationError          String?
  contentDraft              Json?
  contentCreationLeaseUntil DateTime?
  publication               Publication?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([companyId, id])
  @@index([companyId, date])
  @@index([contentId, status, date])
  @@map("content_scheduled")
}

model Publication {
  id              String            @id @default(uuid())
  companyId       String
  scheduleId      String
  schedule        ContentScheduled  @relation(fields: [companyId, scheduleId], references: [companyId, id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount     @relation(fields: [companyId, socialAccountId], references: [companyId, id], onDelete: NoAction)
  status          PublicationStatus @default(SCHEDULED)
  caption         String?
  containerId     String?
  externalId      String?
  error           String?
  leaseUntil      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([companyId, scheduleId])
  @@index([status, updatedAt])
  @@map("publications")
}

// Configuração de um template de foto (PRODUCT_AD_TEMPLATES) na empresa: o tipo de foto preferido em cada uma das três
// cenas (abertura, benefícios, fechamento). Sem registro, as fotos entram na ordem escolhida no conteúdo.
model ImageTemplateSetting {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template  String
  slotKinds MediaAssetKind[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, template])
  @@map("image_template_settings")
}
