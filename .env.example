PORT=3003
SERVICE_BASE_URL=https://seu-tunel.devtunnels.ms
PROD_SERVICE_BASE_URL=
DATABASE_URL=postgresql://service_b:service_b_local@localhost:5433/service_b?schema=public
# openssl rand -hex 32
JWT_SECRET=
CORS_ORIGIN=
# Origem do frontend. O retorno da autorização do Instagram é redirecionado para uma página dele.
FRONTEND_URL=http://localhost:3001

S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Assina os webhooks internos (roteiro do Claude). echo "whsec_$(openssl rand -base64 32)"
INTERNAL_WEBHOOK_SECRET=
# Opcional. Padrão: http://127.0.0.1:$PORT
INTERNAL_WEBHOOK_BASE_URL=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Login unificado (URL de login do painel em facebook.com com config_id): preencha com o config_id e use em INSTAGRAM_APP_ID/SECRET
# o ID e a chave do app da Meta (Configurações do app > Básico). Vazio: Login do Instagram, com o ID e a chave do app do Instagram.
INSTAGRAM_CONFIG_ID=
INSTAGRAM_GRAPH_VERSION=v27.0
# openssl rand -base64 32
SOCIAL_CREDENTIAL_KEY=

# Vídeo: o Claude escreve o roteiro e o Remotion renderiza o anúncio localmente.
# echo "whsec_$(openssl rand -base64 32)"
REMOTION_WEBHOOK_SECRET=
# Opcional. Padrão: http://127.0.0.1:$PORT/webhooks/remotion (a própria instância).
REMOTION_WEBHOOK_URL=
REMOTION_MAX_CONCURRENT_RENDERS=1
REMOTION_RENDER_TIMEOUT_MS=300000
REMOTION_PRIMARY_COLOR=#2563eb
# Opcionais: diretório do projeto Remotion (padrão ./video), entrada e modo do Chrome (em macOS recente use chrome-for-testing).
REMOTION_DIR=
REMOTION_ENTRY=
REMOTION_CHROME_MODE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# "default" reenvia ao modelo de fallback em caso de recusa; "off" desliga (necessário em modelos sem suporte).
ANTHROPIC_FALLBACKS=default

# Serviço da locução dos anúncios: "openai" (padrão) ou "elevenlabs". Só é usado quando o conteúdo pede voz (audio.voiceover).
SPEECH_PROVIDER=openai
# ElevenLabs (SPEECH_PROVIDER=elevenlabs): chave da conta e ID da voz (uma voz em português do Brasil da biblioteca).
# A voz define timbre e estilo; o tom de voz da marca não é enviado, porque a ElevenLabs não recebe instruções em texto.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 (recomendado) ou eleven_multilingual_v2. O v3 não aceita as frases vizinhas como contexto; recebe o idioma.
ELEVENLABS_MODEL=eleven_v3
# Ajustes da voz de 0 a 1, como no playground: estabilidade (0 Creative, 0.5 Natural, 1 Robust), similaridade e
# exagero de estilo (0 evita voz teatral e risadas). O idioma vai para os modelos que aceitam (v3, flash/turbo v2.5).
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.9
ELEVENLABS_STYLE=0
ELEVENLABS_LANGUAGE=pt

# Locução pela OpenAI TTS (SPEECH_PROVIDER=openai); requer OPENAI_API_KEY.
# A OpenAI desliga o gpt-4o-mini-tts em 06/01/2027 (substituto só pela Realtime API).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Transcrição que confere a locução gravada numa tomada só. Precisa do tempo de cada palavra, que só o whisper-1
# devolve (desligamento anunciado para 26/02/2027). Se falhar, a locução é gravada trecho a trecho.
OPENAI_TRANSCRIBE_MODEL=whisper-1
